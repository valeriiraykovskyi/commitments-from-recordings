# Copy to .env.local and fill in. Never commit real keys.

# Deepgram: speech-to-text and fixture audio. https://console.deepgram.com
DEEPGRAM_API_KEY=

# DeepSeek: commitment extraction. https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Vercel Blob: temporary storage for uploads. Added to the Vercel project when the
# Blob store is connected; pull it locally with `vercel env pull` or copy it from the dashboard.
BLOB_READ_WRITE_TOKEN=
